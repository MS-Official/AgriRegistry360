<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agriregistry_farmer_tree" model="ir.ui.view">
        <field name="name">agriregistry.farmer.tree</field>
        <field name="model">agriregistry.farmer</field>
        <field name="arch" type="xml">
            <tree string="Farmer Registry">
                <field name="farmer_code"/>
                <field name="full_name"/>
                <field name="national_id"/>
                <field name="mobile_number"/>
                <field name="district"/>
                <field name="verification_status"/>
            </tree>
        </field>
    </record>

    <record id="view_agriregistry_farmer_form" model="ir.ui.view">
        <field name="name">agriregistry.farmer.form</field>
        <field name="model">agriregistry.farmer</field>
        <field name="arch" type="xml">
            <form string="Farmer">
                <sheet>
                    <group>
                        <field name="farmer_code"/>
                        <field name="full_name"/>
                        <field name="national_id"/>
                        <field name="mobile_number"/>
                        <field name="district"/>
                        <field name="gn_division"/>
                        <field name="farmer_type"/>
                        <field name="verification_status"/>
                        <field name="registered_by"/>
                        <field name="external_mongo_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agriregistry_farmer" model="ir.actions.act_window">
        <field name="name">Farmers</field>
        <field name="res_model">agriregistry.farmer</field>
        <field name="view_mode">tree,form</field>
    </record>

