    <menuitem id="menu_agriregistry360_root" name="AgriRegistry360" sequence="20"/>
    <menuitem id="menu_agriregistry360_farmers" name="Farmers" parent="menu_agriregistry360_root" action="action_agriregistry_farmer" sequence="10"/>
