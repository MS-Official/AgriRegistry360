{
  "name": "agriregistry360",
  "version": "0.1.0",
  "private": true,
  "description": "Integrated Farm & Farmer Registry demo",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm start --workspace frontend\"",
    "backend": "npm run dev --workspace backend",
    "frontend": "npm start --workspace frontend",
    "install:all": "npm install --workspaces",
    "test": "npm run test --workspace backend && npm run build --workspace frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose down && docker compose up --build",
    "docker:clean": "docker compose down -v"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
